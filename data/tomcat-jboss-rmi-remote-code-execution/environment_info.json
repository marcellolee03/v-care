{
  "service": {
    "port_internal": 8080,
    "protocol": "tcp",
    "application": "jboss-as",
    "version": "1.0",
    "install_method": "image",
    "install_root": "/docker-java-home/jre",
    "config_paths": []
  },
  "os": {
    "distro": "debian",
    "release": "8",
    "package_manager": "apt",
    "repos_reachable": true,
    "tools": [
      "apt",
      "apt-get",
      "awk",
      "base64",
      "bash",
      "capsh",
      "cat",
      "chattr",
      "chmod",
      "chown",
      "cp",
      "curl",
      "cut",
      "dash",
      "dpkg",
      "dpkg-query",
      "egrep",
      "find",
      "findmnt",
      "getcap",
      "getent",
      "grep",
      "gzip",
      "head",
      "hostname",
      "ip",
      "java",
      "ls",
      "mkdir",
      "mount",
      "mv",
      "od",
      "openssl",
      "perl",
      "ping",
      "pkill",
      "ps",
      "readlink",
      "realpath",
      "rm",
      "sed",
      "service",
      "setcap",
      "sh",
      "sort",
      "ss",
      "systemctl",
      "tail",
      "tar",
      "touch",
      "tr",
      "uname",
      "uniq",
      "wget",
      "xargs"
    ]
  },
  "filesystem": {
    "exec_user": "root",
    "writable": [
      "/dev/shm",
      "/docker-java-home/jre",
      "/etc",
      "/home",
      "/opt",
      "/root",
      "/run",
      "/srv",
      "/tmp",
      "/usr",
      "/usr/bin",
      "/usr/lib",
      "/usr/lib/jvm/java-7-openjdk-amd64/jre/bin",
      "/usr/local",
      "/var",
      "/var/lib"
    ],
    "mounts": [],
    "volatile_paths": [
      "/dev/shm",
      "/run",
      "/tmp"
    ],
    "capabilities": [
      "default"
    ],
    "init_system": false,
    "read_only_rootfs": false
  },
  "config_lifecycle": {
    "applies_on_restart": true,
    "main_pid_is_1": false
  }
}
