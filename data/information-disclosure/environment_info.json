{
  "service": {
    "port_internal": 8080,
    "protocol": "tcp",
    "application": "jira",
    "version": "",
    "install_method": "image",
    "install_root": "unknown",
    "config_paths": []
  },
  "os": {
    "distro": "ubuntu",
    "release": "18.04",
    "package_manager": "apt",
    "repos_reachable": true,
    "tools": [
      "apt",
      "apt-get",
      "awk",
      "base64",
      "bash",
      "cat",
      "chattr",
      "chmod",
      "chown",
      "cp",
      "curl",
      "cut",
      "dash",
      "dpkg",
      "dpkg-query",
      "egrep",
      "find",
      "findmnt",
      "getent",
      "grep",
      "gzip",
      "head",
      "hostname",
      "java",
      "javac",
      "ls",
      "mkdir",
      "mount",
      "mv",
      "od",
      "openssl",
      "perl",
      "pkill",
      "ps",
      "readlink",
      "realpath",
      "rm",
      "sed",
      "service",
      "sh",
      "sort",
      "tail",
      "tar",
      "touch",
      "tr",
      "uname",
      "uniq",
      "xargs"
    ]
  },
  "filesystem": {
    "exec_user": "root",
    "writable": [
      "/",
      "/dev/shm",
      "/etc",
      "/home",
      "/opt",
      "/root",
      "/run",
      "/srv",
      "/tmp",
      "/usr",
      "/usr/bin",
      "/usr/lib",
      "/usr/local",
      "/var",
      "/var/atlassian/application-data/jira",
      "/var/lib"
    ],
    "mounts": [
      {
        "type": "volume",
        "source": "/var/lib/docker/volumes/9d7ef40ac58f5b4f113bcfc5fb26917324629a4ddfd623aed70d15e240f15a3b/_data",
        "destination": "/var/atlassian/application-data/jira",
        "rw": true
      }
    ],
    "volatile_paths": [
      "/dev/shm",
      "/run",
      "/tmp"
    ],
    "capabilities": [
      "default"
    ],
    "init_system": false,
    "read_only_rootfs": false
  },
  "config_lifecycle": {
    "applies_on_restart": true,
    "main_pid_is_1": "unknown"
